<p>
  <a href="/dashboard">Dashboard</a> |
  <a href="/customers">Customers</a> |
  <a href="/barbers">Barbers</a> |
  <a href="/services">Services</a> |
  <a href="/users">Users</a> |
  <a href="/logout">Logout (<%= currentUser.full_name %>)</a>
</p>

<h1>User Accounts</h1>
<% if (error) { %><p style="color:red"><%= error %></p><% } %>

<form method="GET" action="/users">
  <input type="text" name="search" value="<%= search %>" placeholder="Search username or name">
  <button type="submit">Search</button>
</form>
<a href="/users/add">Add User</a>

<table border="1">
  <tr><th>ID</th><th>Username</th><th>Full Name</th><th>Role</th><th>Created</th><th>Actions</th></tr>
  <% users.forEach(u => { %>
    <tr>
      <td><%= u.user_id %></td>
      <td><%= u.username %></td>
      <td><%= u.full_name %></td>
      <td><%= u.role %></td>
      <td><%= new Date(u.created_at).toISOString().slice(0, 10) %></td>
      <td>
        <a href="/users/edit/<%= u.user_id %>">Edit</a>
        <form method="POST" action="/users/delete/<%= u.user_id %>" style="display:inline"
              onsubmit="return confirm('Delete this user?')">
          <button type="submit">Delete</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table>