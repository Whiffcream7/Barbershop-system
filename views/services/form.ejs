<%- include('../partials/header') %>

<section class="page-section active-section">
  <div class="page-heading compact">
    <div>
      <p class="eyebrow">SERVICE MANAGEMENT</p>
      <h2><%= service.service_id ? 'Edit' : 'Add' %> service</h2>
    </div>
    <a class="button secondary" href="/services">Back to list</a>
  </div>

  <% if (error) { %><div class="form-alert danger" role="alert"><%= error %></div><% } %>

  <article class="panel form-panel">
    <div class="panel-heading">
      <div><p class="eyebrow">SERVICE RECORD</p><h3><%= service.service_id ? 'Edit' : 'Add' %> service</h3></div>
      <span class="required-note">* Required</span>
    </div>
    <form method="POST" action="<%= action %>">
      <div class="form-grid">
        <label>Service name *
          <input type="text" name="service_name" value="<%= service.service_name || '' %>" placeholder="Service name" required>
        </label>
        <label>Description
          <input type="text" name="description" value="<%= service.description || '' %>" placeholder="Description (optional)">
        </label>
        <label>Price *
          <input type="number" name="price" step="0.01" min="0" value="<%= service.price || '' %>" placeholder="Price" required>
        </label>
        <label>Duration (minutes) *
          <input type="number" name="duration_minutes" min="1" value="<%= service.duration_minutes || '' %>" placeholder="Minutes" required>
        </label>
        <label>Status
          <select name="is_active">
            <option value="1" <%= (service.is_active == 1 || service.is_active === '1') ? 'selected' : '' %>>Active</option>
            <option value="0" <%= (service.is_active == 0 || service.is_active === '0') ? 'selected' : '' %>>Inactive</option>
          </select>
        </label>
      </div>
      <div class="form-actions">
        <a class="button secondary" href="/services">Cancel</a>
        <button class="button primary" type="submit">Save service</button>
      </div>
    </form>
  </article>
</section>

<%- include('../partials/footer') %>
