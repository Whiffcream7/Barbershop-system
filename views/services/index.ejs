<p>
  <a href="/dashboard">Dashboard</a> |
  <a href="/customers">Customers</a> |
  <a href="/barbers">Barbers</a> |
  <a href="/services">Services</a> |
  <a href="/logout">Logout (<%= currentUser.full_name %>)</a>
</p>

<h1>Services</h1>
<% if (error) { %><p style="color:red"><%= error %></p><% } %>

<form method="GET" action="/services">
  <input type="text" name="search" value="<%= search %>" placeholder="Search service">
  <button type="submit">Search</button>
</form>
<a href="/services/add">Add Service</a>

<table border="1">
  <tr><th>ID</th><th>Service</th><th>Description</th><th>Price</th><th>Minutes</th><th>Status</th><th>Actions</th></tr>
  <% services.forEach(s => { %>
    <tr>
      <td><%= s.service_id %></td>
      <td><%= s.service_name %></td>
      <td><%= s.description %></td>
      <td><%= s.price %></td>
      <td><%= s.duration_minutes %></td>
      <td><%= s.is_active ? 'Active' : 'Inactive' %></td>
      <td>
        <a href="/services/edit/<%= s.service_id %>">Edit</a>
        <form method="POST" action="/services/delete/<%= s.service_id %>" style="display:inline"
              onsubmit="return confirm('Delete this service?')">
          <button type="submit">Delete</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table>