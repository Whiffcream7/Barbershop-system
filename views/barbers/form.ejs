<%- include('../partials/header') %>

<section class="page-section active-section">
  <div class="page-heading compact">
    <div>
      <p class="eyebrow">BARBER MANAGEMENT</p>
      <h2><%= barber.barber_id ? 'Edit' : 'Add' %> barber</h2>
    </div>
    <a class="button secondary" href="/barbers">Back to list</a>
  </div>

  <% if (error) { %><div class="form-alert danger" role="alert"><%= error %></div><% } %>

  <article class="panel form-panel">
    <div class="panel-heading">
      <div><p class="eyebrow">BARBER RECORD</p><h3><%= barber.barber_id ? 'Edit' : 'Add' %> barber</h3></div>
      <span class="required-note">* Required</span>
    </div>
    <form method="POST" action="<%= action %>">
      <div class="form-grid">
        <label>First name *
          <input type="text" name="first_name" value="<%= barber.first_name || '' %>" placeholder="First name" required>
        </label>
        <label>Last name *
          <input type="text" name="last_name" value="<%= barber.last_name || '' %>" placeholder="Last name" required>
        </label>
        <label>Specialty
          <input type="text" name="specialty" value="<%= barber.specialty || '' %>" placeholder="Specialty (optional)">
        </label>
        <label>Phone
          <input type="text" name="phone" value="<%= barber.phone || '' %>" placeholder="Phone (optional)">
        </label>
        <label>Status
          <select name="status">
            <option value="active" <%= barber.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= barber.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
          </select>
        </label>
      </div>
      <div class="form-actions">
        <a class="button secondary" href="/barbers">Cancel</a>
        <button class="button primary" type="submit">Save barber</button>
      </div>
    </form>
  </article>
</section>

<%- include('../partials/footer') %>
