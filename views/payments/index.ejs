<%- include('../partials/header') %>
  
<section class="page-section active-section">
  <div class="page-heading compact">
    <div>
      <p class="eyebrow">PAYMENTS</p>
      <h2>Payments</h2>
      <p class="muted">View recorded payments and record a new one for an appointment.</p>
    </div>
    <a class="button primary" href="/payments/add">+ Record payment</a>
  </div>

  <% if (success) { %>
    <div class="form-alert success" role="status">Payment recorded successfully.</div>
  <% } %>

  <article class="panel table-panel">
    <div class="toolbar">
      <div><strong>Payment records</strong><small><%= payments.length %> recorded</small></div>
      <form class="search-box" method="get" action="/payments">
        <input type="search" name="search" placeholder="Search customer, barber, or receiver..." value="<%= search %>">
        <button class="button secondary" type="submit">Search</button>
    </form>
    </div>

    <% if (payments.length === 0) { %>
      <p class="muted" style="padding:16px">No payments recorded yet.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Payment ID <a style="cursor: pointer; font-size: medium;" onclick="sortAppointments('payment_id')">⇵</a></th>
              <th>Appointment ID <a style="cursor: pointer; font-size: medium;" onclick="sortAppointments('appointment_id')">⇵</a></th>
              <th>Customer <a style="cursor: pointer; font-size: medium;" onclick="sortAppointments('customer')">⇵</a></th>
              <th>Barber <a style="cursor: pointer; font-size: medium;" onclick="sortAppointments('barber')">⇵</a></th>
              <th>Amount <a style="cursor: pointer; font-size: medium;" onclick="sortAppointments('amount')">⇵</a></th>
              <th>Method</th>
              <th>Received by <a style="cursor: pointer; font-size: medium;" onclick="sortAppointments('received_by')">⇵</a></th>
              <th>Payment date <a style="cursor: pointer; font-size: medium;" onclick="sortAppointments('payment_date')">⇵</a></th>
            </tr>
          </thead>
          <tbody>
            <% payments.forEach(payment => { %>
              <tr>
                <td><%= payment.payment_id %></td>
                <td><%= payment.appointment_id %></td>
                <td><strong><%= payment.customer_name %></strong></td>
                <td><%= payment.barber_name %></td>
                <td>₱<%= Number(payment.amount).toFixed(2) %></td>
                <td><span class="status <%= payment.payment_method === 'gcash' ? 'blue' : 'green' %>"><%= payment.payment_method %></span></td>
                <td><%= payment.received_by %></td>
                <td><%= new Date(payment.payment_date).toLocaleString('en-PH', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                  hour: 'numeric',
                  minute: '2-digit',
                  hour12: true
                }) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </article>
</section>

<%- include('../partials/footer') %>

<script>
  function sortAppointments(sortBy) {
      // Get the current URL
      const url = new URL(window.location.href);

      // Get the current sorting settings
      const currentSort = url.searchParams.get('sort');
      const currentOrder = url.searchParams.get('order');

      // If clicking the same column, reverse the order
      if (currentSort === sortBy && currentOrder === 'asc') {
          url.searchParams.set('order', 'desc');
      } else {
          // Otherwise, start with ascending
          url.searchParams.set('sort', sortBy);
          url.searchParams.set('order', 'asc');
      }
      
      // Reload the page with the new sorting
      window.location.href = url.toString();
  }
</script>