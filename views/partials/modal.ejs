<div id="appModal" class="modal-overlay hidden" role="dialog" aria-modal="true">
  <div id="modalCard" class="modal-card modal-warning">

    <div id="modalIcon" class="modal-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        <line x1="12" y1="9" x2="12" y2="13"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
    </div>

    <div class="modal-content">
      <p id="modalCategory" class="eyebrow">WARNING</p>
      <h3 id="modalTitle">AN ERROR OCCURED</h3>
      <p id="modalMessage" class="modal-message">An input is invalid please check again.</p>
    </div>

    <div class="modal-actions">
      <button id="modalCancelBtn" type="button" class="button secondary">Cancel</button>
      <button id="modalConfirmBtn" type="button" class="button primary">Confirm</button>
    </div>

  </div>
</div>