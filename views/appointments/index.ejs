<%- include('../partials/header') %>


<section class="page-section active-section">
    <div class="page-heading compact">
        <div>
            <p class="eyebrow">APPOINTMENT MANAGEMENT</p>
            <h2>Appointments</h2>
            <p class="muted">View, add, update, and cancel appointments.</p>
        </div>
        <a class="button primary" href="/appointments/add">+ Add Appointment</a>
    </div>

    <!-- toolbar / filter / sort -->
    <article class=" panel table-panel">
        <div class="toolbar">
            <div><strong></strong></div>
            <form class="page-heading" method="get" action="/appointments" id="filterForm">
                <label class="muted" for="date">Date:</label>
                <select name="date" id="date">
                    <option value="all" <%= selectedDate === 'today' ? 'selected' : ''  %>>All</option>
                    <option value="today" <%= selectedDate === 'today' ? 'selected' : ''  %>>Today</option>
                    <option value="week" <%= selectedDate === 'week' ? 'selected' : ''  %>>This Week</option>
                    <option value="month" <%= selectedDate === 'month' ? 'selected' : ''  %>>This Month</option>
                    <option value="older" <%= selectedDate === 'older' ? 'selected' : ''  %>>Older</option>
                </select>
                

                <label class="muted" for="status">Status:</label>
                <select name="status" id="status">
                    <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>All</option>
                    <option value="booked" <%= selectedStatus === 'booked' ? 'selected' : '' %>>Booked</option>
                    <option value="completed" <%= selectedStatus === 'completed' ? 'selected' : '' %>>Completed</option>
                    <option value="cancelled" <%= selectedStatus === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                    <option value="no_show" <%= selectedStatus === 'no_show' ? 'selected' : '' %>>No-show</option>
                </select>

                <label for="booking_type">Booking Type:</label>
                <select name="booking_type" id="booking_type">
                    <option value="all" <%= selectedBookingType === 'all' ? 'selected' : '' %>>All</option>
                    <option value="scheduled" <%= selectedBookingType === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
                    <option value="walk_in" <%= selectedBookingType === 'walk_in' ? 'selected' : '' %>>Walk-in</option>
                </select>
            </form>
            
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Date <a style="cursor: pointer; font-size: medium;" onclick="sortAppointments('date')">⇵</a></th>
                        <th>Start <a style="cursor: pointer; font-size: medium;" onclick="sortAppointments('start')">⇵</a></th>
                        <th>End <a style="cursor: pointer; font-size: medium;" onclick="sortAppointments('end')">⇵</a></th>
                        <th>Customer <a style="cursor: pointer; font-size: medium;" onclick="sortAppointments('customer')">⇵</a></th>
                        <th>Barber <a style="cursor: pointer; font-size: medium;" onclick="sortAppointments('barber')">⇵</a></th>
                        <th>Services</th>
                        <th>Booking Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    <% appointments.forEach(appointment=> { %>
                        <tr>
                            <td><%= new Date(appointment.appointment_date).toLocaleString('en-PH', {
                                weekday: 'short',
                                month: 'short',
                                day: 'numeric',
                                year: 'numeric'
                            }) %></td>
                            <td><%= new Date(`1970-01-01T${appointment.start_time}`).toLocaleTimeString('en-PH', {
                                hour: 'numeric',
                                minute: '2-digit'
                            }) %></td>
                            <td><%= new Date(`1970-01-01T${appointment.end_time}`).toLocaleTimeString('en-PH', {
                                hour: 'numeric',
                                minute: '2-digit'
                            }) %></td>
                            <td><%= appointment.customer_name %></td>
                            <td><%= appointment.barber_name %></td>
                            <td><%= appointment.services %></td>
                            <td><%= appointment.booking_type %></td>
                            <td><%= appointment.status %></td>
                            <td>
                                <% if (appointment.status==='booked' && appointment.booking_type === 'scheduled') { %>
                                    <div class="action-links">
                                        <button class="button">
                                            <a href="/appointments/edit/<%= appointment.appointment_id %>">Edit</a>
                                        </button>
                                        
                                        <form method="post" action="/appointments/status/<%= appointment.appointment_id %>">
                                            <button class="button" type="submit" name="status" value="cancelled">Cancel</button>
                                        </form>

                                        <form method="post" action="/appointments/status/<%= appointment.appointment_id %>">
                                            <button class="button" type="submit" name="status" value="no_show">No-show</button>
                                        </form>
                                    </div>
                                    
                                <% } else { %>
                                    No actions available
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </article>

</section>

<script>
    const filterForm = document.getElementById('filterForm');
    const filters = filterForm.querySelectorAll('select');

    filters.forEach(function(filter) {
        filter.addEventListener('change', function() {
            filterForm.submit();
        });
    });

    function sortAppointments(sortBy) {
        // Get the current URL
        const url = new URL(window.location.href);

        // Get the current sorting settings
        const currentSort = url.searchParams.get('sort');
        const currentOrder = url.searchParams.get('order');

        // If clicking the same column, reverse the order
        if (currentSort === sortBy && currentOrder === 'asc') {
            url.searchParams.set('order', 'desc');
        } else {
            // Otherwise, start with ascending
            url.searchParams.set('sort', sortBy);
            url.searchParams.set('order', 'asc');
        }
        
        // Reload the page with the new sorting
        window.location.href = url.toString();
    }
</script>
