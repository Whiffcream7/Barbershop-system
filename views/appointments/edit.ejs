<%- include('../partials/header') %>

<%
  // Format the date using the local date parts. (toISOString() converts to UTC
  // and shows the previous day in the Philippines.)
  const apptDate = new Date(appointment.appointment_date);
  const apptDateValue = apptDate.getFullYear() + '-' +
    String(apptDate.getMonth() + 1).padStart(2, '0') + '-' +
    String(apptDate.getDate()).padStart(2, '0');
%>

<section class="page-section active-section">
  <div class="page-heading compact">
    <div>
      <p class="eyebrow">APPOINTMENT MANAGEMENT</p>
      <h2>Edit appointment</h2>
    </div>
    <a class="button secondary" href="/appointments">Back to appointments</a>
  </div>

  <article class="panel form-panel">
    <div class="panel-heading">
      <div><p class="eyebrow">APPOINTMENT RECORD</p><h3>Edit appointment #<%= appointment.appointment_id %></h3></div>
      <span class="required-note">* Required</span>
    </div>

    <form method="POST" action="/appointments/edit/<%= appointment.appointment_id %>">
      <div class="form-grid">
        <label>Customer *
          <select name="customer_id" id="customer_id" required>
            <% customers.forEach(customer=> { %>
              <option value="<%= customer.customer_id %>" <%= customer.customer_id==appointment.customer_id ? 'selected' : '' %>><%= customer.first_name %> <%= customer.last_name %></option>
            <% }) %>
          </select>
        </label>

        <label>Barber *
          <select name="barber_id" id="barber_id" required>
            <% barbers.forEach(barber=> { %>
              <option value="<%= barber.barber_id %>" <%= barber.barber_id==appointment.barber_id ? 'selected' : '' %>><%= barber.first_name %> <%= barber.last_name %></option>
            <% }) %>
          </select>
        </label>

        <label>Date *
          <input type="date" name="appointment_date" id="appointment_date" value="<%= apptDateValue %>" required>
        </label>

        <label>Start time *
          <input type="time" name="start_time" id="start_time" value="<%= appointment.start_time %>" required>
        </label>

        <label>End time (calculated)
          <input type="text" id="end_time" readonly>
        </label>
      </div>

      <fieldset style="border:0;padding:0;margin:20px 0 0">
        <legend class="eyebrow" style="padding:0;margin-bottom:10px">SERVICES</legend>
        <% services.forEach(service=> { %>
          <label for="service_<%= service.service_id %>" style="display:flex;gap:10px;align-items:center;padding:6px 0;cursor:pointer">
            <input type="checkbox" name="service_ids" value="<%= service.service_id %>" id="service_<%= service.service_id %>" data-duration="<%= service.duration_minutes %>" <%= selectedServiceIds.includes(service.service_id) ? 'checked' : '' %> style="width:18px;height:18px;padding:0;flex:0 0 auto">
            <span><%= service.service_name %> - ₱<%= service.price %> (<%= service.duration_minutes %> mins)</span>
          </label>
        <% }) %>
      </fieldset>

      <div class="form-actions">
        <a class="button secondary" href="/appointments">Cancel</a>
        <button class="button primary" type="submit">Save changes</button>
      </div>
    </form>
  </article>
</section>

<script>
    // Get the start time and end time fields
    const startTimeInput = document.getElementById('start_time');
    const endTimeInput = document.getElementById('end_time');

    // Get all service checkboxes
    const serviceCheckboxes = document.querySelectorAll('input[name="service_ids"]');

    // Calculate the end time whenever the start time or selected services change
    function calculateEndTime() {
        if (!startTimeInput.value) {
            endTimeInput.value = '';
            return;
        }

        // Get the start time as hours and minutes
        const [hours, minutes] = startTimeInput.value.split(':').map(Number);

        //Convert the start time to total minutes
        let totalMinutes = hours * 60 + minutes;

        //Add the duration of every selected service
        serviceCheckboxes.forEach(checkbox => {
            if (checkbox.checked) {
                totalMinutes += Number(checkbox.dataset.duration);
            }
        });

        // Make sure the appointment does not go into the next day
        if (totalMinutes >= 24 * 60) {
            endTimeInput.value = 'Invalid time';
            return;
        }

        // Convert the total minutes back to hours and minutes
        const endHours = Math.floor(totalMinutes / 60);
        const endMinutes = totalMinutes % 60;

        // Convert to 12-hour format
        const period = endHours >= 12 ? 'PM' : 'AM';
        const displayHours = endHours % 12 || 12;

        // Display the calculated time
        endTimeInput.value =
            `${displayHours}:${String(endMinutes).padStart(2, '0')} ${period}`;
    }

    // Recalculate when the start time changes
    startTimeInput.addEventListener('change', calculateEndTime);

    //Recalculate when a service is selected/unselected
    serviceCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', calculateEndTime);
    });

    //Calculate the end time when the edit page first loads
    calculateEndTime();
</script>

<%- include('../partials/modal') %>

<script>
    const errorMessage = <%- JSON.stringify(error || '') %>;

    if (errorMessage) {
        document.getElementById('modalMessage').textContent = errorMessage;
        document.getElementById('appModal').classList.remove('hidden');
    }

    document.getElementById('modalCancelBtn').addEventListener('click', () => {
        document.getElementById('appModal').classList.add('hidden');
    });

    document.getElementById('modalConfirmBtn').addEventListener('click', () => {
        document.getElementById('appModal').classList.add('hidden');
    });
</script>

<%- include('../partials/footer') %>
