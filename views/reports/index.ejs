<%- include('../partials/header') %>

<section class="page-section active-section">
  <div class="page-heading compact">
    <div>
      <p class="eyebrow">REPORTS</p>
      <h2>Daily report</h2>
      <p class="muted">Choose a date to see appointments, sales, barber activity and popular services.</p>
    </div>
    <a class="button secondary" href="/dashboard">Back to dashboard</a>
  </div>

  <article class="panel table-panel">
    <div class="toolbar">
      <div><strong>Report date</strong></div>
      <form class="search-box" method="get" action="/reports">
        <input type="date" name="date" id="date" value="<%= selectedDate %>" required>
        <button class="button primary" type="submit">View report</button>
      </form>
    </div>
  </article>

  <article class="panel" style="margin-top:14px">
    <div class="panel-heading">
      <div><p class="eyebrow">SUMMARY</p><h3>Report summary</h3></div>
    </div>
    <div style="padding:0 22px 22px">
      <p>Total appointments: <strong><%= totalAppointments %></strong></p>
      <p>Total sales: <strong>₱<%= Number(totalSales).toFixed(2) %></strong></p>
    </div>
  </article>

  <article class="panel table-panel" style="margin-top:14px">
    <div class="toolbar"><div><strong>Appointments per barber</strong></div></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Barber</th><th>Appointments</th></tr></thead>
        <tbody>
          <% if (barberAppointments.length === 0) { %>
            <tr><td colspan="2">No appointments found for this date.</td></tr>
          <% } else { %>
            <% barberAppointments.forEach(barber => { %>
              <tr>
                <td><strong><%= barber.barber_name %></strong></td>
                <td><%= barber.appointment_count %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </article>

  <article class="panel table-panel" style="margin-top:14px">
    <div class="toolbar"><div><strong>Popular services</strong></div></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Service</th><th>Times selected</th></tr></thead>
        <tbody>
          <% if (popularServices.length === 0) { %>
            <tr><td colspan="2">No services found for this date.</td></tr>
          <% } else { %>
            <% popularServices.forEach(service => { %>
              <tr>
                <td><strong><%= service.service_name %></strong></td>
                <td><%= service.times_selected %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </article>
</section>

<%- include('../partials/footer') %>
